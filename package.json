{
  "name": "dsh-vsc-git-graph",
  "version": "0.1.0",
  "description": "VS Code-style commit graph and branch actions for DeepSeek Harness.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Si-xiyu/dsh-git-graph.git"
  },
  "homepage": "https://github.com/Si-xiyu/dsh-git-graph#readme",
  "bugs": {
    "url": "https://github.com/Si-xiyu/dsh-git-graph/issues"
  },
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": {
      "default": "./lib/index.js"
    },
    "./client": {
      "default": "./lib/client.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md",
    "LICENSE",
    "THIRD_PARTY_NOTICES.md",
    "licenses",
    "docs/TRIAL-INSTALL.md"
  ],
  "scripts": {
    "test": "node --test --test-timeout=60000 test/*.test.js",
    "prepublishOnly": "npm test",
    "build": "node scripts/build.mjs",
    "dist": "node scripts/dist.mjs"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-runtime",
        "@deepseek-ai/dsh-client-ui-primitives",
        "@deepseek-ai/dsh-client-ui-settings-general"
      ],
      "platform": "web"
    }
  },
  "dshhub": {
    "schemaVersion": 1,
    "displayName": "Git Graph",
    "summary": "集成 Git 状态/提交图/分支/差异/提交/推送拉取的 DeepSeek Harness 插件，界面中英双语（当前为 Git 专用）。Git plugin for DeepSeek Harness: status / commit graph / branches / diff / commit / push / pull, bilingual UI (Git-only build).",
    "categories": [
      "Git",
      "Web UI"
    ],
    "surfaces": [
      "host",
      "web"
    ],
    "capabilities": {
      "provides": [
        "route:/vsc-git-graph"
      ]
    },
    "compatibility": {
      "dsh": ">=0.1.0-rc.5",
      "node": ">=20"
    }
  },
  "keywords": [
    "deepseek",
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "client-plugin",
    "git",
    "git-graph",
    "i18n",
    "bilingual",
    "zh",
    "en"
  ],
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "react": "^18.2.0",
    "@deepseek-ai/dsh-client-runtime": "*",
    "@deepseek-ai/dsh-client-ui-primitives": "*",
    "@deepseek-ai/dsh-client-ui-settings-general": "*"
  },
  "license": "MIT",
  "engines": {
    "node": ">=20",
    "dsh": ">=0.1.0-rc.5"
  }
}
